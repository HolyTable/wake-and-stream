#!/bin/bash
# pc – use your Windows PC from the Mac (through your router's VPN)
#
#   pc on       turn the PC on (via UpSnap) and wait until it is ready
#   pc work     turn on if needed, then open the remote desktop app
#   pc play     turn on if needed, then start the Moonlight stream
#   pc stop     end a paused Moonlight stream on the PC (monitors back on)
#   pc release  end the remote desktop session and hand it back to the PC screen, unlocked
#   pc off      shut the PC down
#   pc sleep    put the PC to sleep
#   pc status   is the PC on?
#   pc state    machine-readable state for the widget app (key=value lines)
#   pc doctor   check every link (VPN, UpSnap, PC, SSH, Windows part, Apollo, Mac apps) – changes nothing
#
# German aliases: an, arbeiten (rdp), spielen (moon), stopp, zurueck, aus, standby, doktor
# Settings: ~/.config/wake-and-stream/config   (language, IPs, user, …)

# shellcheck source=/dev/null
. "$HOME/.config/wake-and-stream/lib.sh" 2>/dev/null || { echo "wake-and-stream is not installed – run install.sh"; exit 1; }
[ -n "$PC_IP" ] || { t no_config; exit 1; }

require_home() { home_reachable || { t no_home; exit 1; }; }

# SSH to the PC: key only (never a password prompt that would hang the menu), give up after 5 s
pc_ssh() { ssh -o BatchMode=yes -o ConnectTimeout=5 "$PC_USER@$PC_IP" "$@"; }

# Close Moonlight on the Mac (if open) and wait until it is really gone
moonlight_close() {
  pkill -x Moonlight 2>/dev/null || return 0
  for _ in 1 2 3 4 5; do pgrep -x Moonlight >/dev/null || return 0; sleep 1; done
  pkill -9 -x Moonlight 2>/dev/null; return 0
}

# Put the Moonlight stream window into macOS full screen (like the remote desktop app):
# the menu bar then appears when the mouse touches the top edge.
# Moonlight opens several windows (an invisible helper window and the stream window), so we wait
# up to 30 s for a visible window at least 800 points wide, take the largest one, give the video
# a moment to start and only then switch it to full screen.
# Needs the Accessibility permission for the app that runs this (SwiftBar / Terminal).
moonlight_fullscreen() {
  osascript >/dev/null 2>&1 <<'APPLESCRIPT'
tell application "System Events"
  repeat 60 times
    if exists process "Moonlight" then
      tell process "Moonlight"
        set best to missing value
        set bestArea to 0
        repeat with w in windows
          try
            set {ww, hh} to size of w
            if ww ≥ 800 and (ww * hh) > bestArea then
              set best to w
              set bestArea to ww * hh
            end if
          end try
        end repeat
        if best is not missing value then
          delay 1.5
          try
            if (value of attribute "AXFullScreen" of best) is false then
              set value of attribute "AXFullScreen" of best to true
            end if
          end try
          return
        end if
      end tell
    end if
    delay 0.5
  end repeat
end tell
APPLESCRIPT
}

# Log in to UpSnap's API with the login from the macOS keychain → sets UPSNAP_TOKEN.
# Returns 2 = no login in the keychain, 1 = UpSnap refused the login (or did not answer).
upsnap_login() {
  local user pass json coll
  UPSNAP_TOKEN=""
  user=$(security find-generic-password -s "$KEYCHAIN_SERVICE" 2>/dev/null | sed -n 's/.*"acct"<blob>="\(.*\)"/\1/p')
  pass=$(security find-generic-password -s "$KEYCHAIN_SERVICE" -w 2>/dev/null)
  [ -n "$user" ] && [ -n "$pass" ] || return 2
  pass=${pass//\\/\\\\}; pass=${pass//\"/\\\"}                       # escape for JSON
  # UpSnap admin = PocketBase superuser, otherwise a normal user; password goes via stdin, not as an argument
  for coll in _superusers users; do
    json=$(printf '{"identity":"%s","password":"%s"}' "$user" "$pass" |
      curl -s -m 5 -X POST "$UPSNAP_URL/api/collections/$coll/auth-with-password" -H 'Content-Type: application/json' --data @-)
    UPSNAP_TOKEN=$(printf '%s' "$json" | sed -n 's/.*"token":"\([^"]*\)".*/\1/p')
    [ -n "$UPSNAP_TOKEN" ] && return 0
  done
  return 1
}

# Find the PC in UpSnap by its IP (needs upsnap_login first) → sets UPSNAP_ID. Returns 1 if not found.
upsnap_device() {
  UPSNAP_ID=$(curl -s -m 5 -G "$UPSNAP_URL/api/collections/devices/records" -H "Authorization: $UPSNAP_TOKEN" \
         --data-urlencode "filter=ip='$PC_IP'" | grep -o '"id":"[^"]*"' | head -n 1 | cut -d'"' -f4)
  [ -n "$UPSNAP_ID" ]
}

# Wake the PC through UpSnap's API. Returns 1 if not possible.
upsnap_wake() {
  upsnap_login && upsnap_device || return 1
  # UpSnap only answers once the PC is up – run in the background, we wait below
  # (all output to /dev/null, otherwise the menu would wait for this background request)
  curl -s -m 150 -o /dev/null "$UPSNAP_URL/api/upsnap/wake/$UPSNAP_ID" -H "Authorization: $UPSNAP_TOKEN" >/dev/null 2>&1 &
  return 0
}

# pc doctor – checks every link of the chain once (Mac → VPN → UpSnap → PC → SSH → Windows part →
# Apollo) and says what is wrong and where to look. Changes nothing. Exit code 1 if something failed.
DR_FAIL=0
DR_PLAIN=""   # "pc doctor --plain": one line per check, tab-separated (read by the widget app)
dr() {  # dr ok|bad|skip|info <label> <detail> [hint]
  local mark
  if [ -n "$DR_PLAIN" ]; then
    [ "$1" = bad ] && DR_FAIL=$((DR_FAIL+1))
    printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4"; return 0
  fi
  case "$1" in ok) mark="✓";; bad) mark="✗"; DR_FAIL=$((DR_FAIL+1));; skip) mark="–";; *) mark="·";; esac
  printf '  %s %-15s %s\n' "$mark" "$2" "$3"
  [ -z "$4" ] || printf '      → %s\n' "$4"
  return 0
}
# one SSH call, PowerShell reads the commands from stdin (no quoting through cmd.exe), answers key=value
win_check() {
  printf '%s\n' \
    "\$d = '$WINDOWS_DIR'" \
    "'scripts=' + [int](Test-Path (Join-Path \$d 'release-session.bat'))" \
    "'psexec=' + [int](Test-Path (Join-Path \$d 'PsExec64.exe'))" \
    "'monitors=' + [int][bool](Get-ScheduledTask -TaskPath '\\WakeAndStream\\' -TaskName 'Monitors off on remote desktop' -ErrorAction SilentlyContinue)" \
    "'autosleep=' + [int][bool](Get-ScheduledTask -TaskPath '\\WakeAndStream\\' -TaskName 'Auto sleep' -ErrorAction SilentlyContinue)" \
    "'lastsleep=' + (Get-Content (Join-Path \$d 'auto-sleep.log') -Tail 1 -ErrorAction SilentlyContinue)" |
    pc_ssh powershell -NoProfile -NonInteractive -Command - 2>/dev/null | tr -d '\r'
}
val() { printf '%s\n' "$1" | sed -n "s/^$2=//p" | head -n 1; }

pc_doctor() {
  local rc out err missing last v
  [ "$1" = --plain ] && DR_PLAIN=1
  [ -n "$DR_PLAIN" ] || t dr_title
  # 1. configuration
  missing=""
  for v in PC_USER ROUTER_IP UPSNAP_URL; do eval "[ -n \"\$$v\" ]" || missing="$missing $v"; done
  if [ -n "$missing" ]; then dr bad "$(t dr_config)" "$(t dr_config_missing)$missing" "$(t dr_config_hint)"
  else dr ok "$(t dr_config)" "$WAS_CONFIG"; fi

  # 2. home network (directly or through the VPN)
  if ! home_reachable; then
    dr bad "$(t dr_home)" "$(t dr_home_bad)" "$(t dr_home_hint)"
    dr skip "$(t dr_rest)" "$(t dr_rest_skipped)"
  else
    dr ok "$(t dr_home)" "$(t dr_home_ok)"

    # 3. UpSnap: reachable, login from the keychain, PC known
    if ! curl -s -m 5 "$UPSNAP_URL/api/health" 2>/dev/null | grep -q '"code":200'; then
      dr bad UpSnap "$(t dr_upsnap_down)" "$(t dr_upsnap_down_hint)"
    else
      upsnap_login; rc=$?
      if [ $rc -eq 2 ]; then dr bad UpSnap "$(t dr_upsnap_nokey)" "$(t dr_upsnap_nokey_hint)"
      elif [ $rc -ne 0 ]; then dr bad UpSnap "$(t dr_upsnap_login)" "$(t dr_upsnap_login_hint)"
      elif ! upsnap_device; then dr bad UpSnap "$(t dr_upsnap_nodev)" "$(t dr_upsnap_nodev_hint)"
      else dr ok UpSnap "$(t dr_upsnap_ok)"; fi
    fi

    # 4. the PC itself – only if it is on (doctor never wakes it)
    if ! port_open 3389; then
      dr info PC "$(t dr_pc_off)"
    else
      dr ok PC "$(t dr_pc_on)"
      if ping -c1 -t1 "$PC_IP" >/dev/null 2>&1; then dr ok Ping "$(t dr_ping_ok)"
      else dr bad Ping "$(t dr_ping_bad)" "$(t dr_ping_hint)"; fi

      err=$(pc_ssh 'echo was-ok' 2>&1)
      if ! printf '%s' "$err" | grep -q was-ok; then
        dr bad SSH "$(printf '%s' "$err" | tail -n 1)" "$(t dr_ssh_hint)"
      else
        dr ok SSH "$(t dr_ssh_ok)"
        out=$(win_check)
        missing=""
        [ "$(val "$out" scripts)" = 1 ]  || missing="$missing release-session.bat"
        [ "$(val "$out" psexec)" = 1 ]   || missing="$missing PsExec64.exe"
        [ "$(val "$out" monitors)" = 1 ] || missing="$missing task:Monitors-off"
        if [ -n "$missing" ]; then dr bad "$(t dr_win)" "$(t dr_win_missing)$missing" "$(t dr_win_hint)"
        else dr ok "$(t dr_win)" "$WINDOWS_DIR"; fi
        if [ "$(val "$out" autosleep)" = 1 ]; then
          last=$(val "$out" lastsleep)
          dr info "$(t dr_sleep)" "$(t dr_sleep_on)${last:-$(t dr_sleep_never)}"
        else
          dr info "$(t dr_sleep)" "$(t dr_sleep_off)"
        fi
      fi

      if port_open 47989; then dr ok Apollo "$(t dr_apollo_ok)"
      else dr bad Apollo "$(t dr_apollo_bad)" "$(t dr_apollo_hint)"; fi
    fi
  fi

  # 5. on this Mac
  missing=""
  open -Ra Moonlight >/dev/null 2>&1 || missing="$missing Moonlight"
  open -Ra "$RDP_APP" >/dev/null 2>&1 || missing="$missing \"$RDP_APP\""
  if [ -n "$missing" ]; then dr bad "$(t dr_apps)" "$(t dr_apps_missing)$missing" "$(t dr_apps_hint)"
  else dr ok "$(t dr_apps)" "Moonlight, $RDP_APP"; fi
  if [ ! -d "$HOME/Applications/Wake and Stream.app" ]; then dr skip Widget "$(t dr_widget_none)"
  elif pgrep -a -x WakeAndStream >/dev/null; then dr ok Widget "$(t dr_widget_ok)"
  else dr bad Widget "$(t dr_widget_bad)" "$(t dr_widget_hint)"; fi

  [ -n "$DR_PLAIN" ] && { [ $DR_FAIL -eq 0 ]; exit; }
  echo
  if [ $DR_FAIL -eq 0 ]; then t dr_all_ok; else t dr_problems "$DR_FAIL"; exit 1; fi
}

# Turn the PC on if needed and wait until the given port answers
start_pc() {
  port_open "$1" && return
  if upsnap_wake; then t waking; else t wake_fallback; open "$UPSNAP_URL"; fi
  t waiting
  for _ in $(seq 1 90); do
    port_open "$1" && { t arrived; sleep 5; return; }
    printf "."; sleep 2
  done
  echo; t timeout; exit 1
}

case "$1" in
  on|an)
    require_home
    port_open 3389 && { t already_on; exit 0; }
    start_pc 3389; t ready ;;
  work|rdp|arbeiten)
    require_home; start_pc 3389
    open -a "$RDP_APP"
    t rdp_ready ;;
  play|moon|spielen)
    require_home; start_pc 47989
    # Only one Moonlight at a time: close a running one first, because macOS ignores the
    # arguments when the app is already open. Started through "open" so it keeps running
    # when launched from the menu bar. ctrl+option+shift+Q only pauses the stream – "pc stop" ends it.
    moonlight_close
    open -a Moonlight --args stream "$PC_IP" "$STREAM_APP"
    touch "$WAS_STREAM"
    # in the background, so the menu does not wait for it
    [ "$PLAY_FULLSCREEN" = yes ] && { nohup bash -c "$(declare -f moonlight_fullscreen); moonlight_fullscreen" >/dev/null 2>&1 & disown; }
    t moon_start ;;
  stop|stopp)
    # ask the PC to end the app (Apollo/Sunshine then turns the real monitors back on) …
    moonlight_close
    open -a Moonlight --args quit "$PC_IP"
    # … Moonlight closes itself once the PC confirmed – give it up to 15 s, then close it anyway
    for _ in $(seq 1 15); do pgrep -x Moonlight >/dev/null || break; sleep 1; done
    moonlight_close
    rm -f "$WAS_STREAM"
    t stopping ;;
  release|zurueck)
    # 1. close the remote desktop app at once – the session on the PC is then just "disconnected",
    #    so the "another connection was made" warning never shows up
    pkill -x "$RDP_APP" 2>/dev/null && sleep 2
    # 2. hand the disconnected session back to the PC screen, unlocked
    pc_ssh "$WINDOWS_DIR\\release-session.bat" || exit 1
    t released ;;
  off|aus)
    pc_ssh 'shutdown /s /t 0' || exit 1
    rm -f "$WAS_STREAM"; t shutting_down ;;
  sleep|standby)
    # the PC falls asleep before it can answer – run in the background (output to /dev/null) and don't wait
    pc_ssh 'rundll32.exe powrprof.dll,SetSuspendState 0,1,0' >/dev/null 2>&1 &
    sleep 3; rm -f "$WAS_STREAM"; t sleeping ;;
  status)
    if port_open 3389; then t is_on; else t is_off; fi ;;
  doctor|doktor|check)
    pc_doctor "$2" ;;
  state)
    was_state
    printf 'home=%s\non=%s\nstream=%s\nrdp=%s\nlast=%s\nlang=%s\n' \
      "$S_HOME" "$S_ON" "$S_STREAM" "$S_RDP" "$S_LAST" "$LANGUAGE" ;;
  *)
    if [ "$LANGUAGE" = de ]; then
      cat <<'HILFE'
pc – Desktop-PC fernsteuern

  Einschalten & verbinden
    pc an          PC einschalten (ohne Verbindung)
    pc arbeiten    einschalten + Remotedesktop
    pc spielen     einschalten + Moonlight

  Beenden
    pc stopp       Moonlight-Stream beenden (Monitore wieder an)
    pc zurueck     Remotedesktop beenden (PC-Bildschirm entsperrt)

  Ausschalten
    pc aus         herunterfahren
    pc standby     schlafen legen

  Info
    pc status      ist der PC an?
    pc doktor      alles prüfen (VPN, UpSnap, SSH, Apollo …), sagt was fehlt
HILFE
    else
      cat <<'HELP'
pc – control your desktop PC remotely

  Turn on & connect
    pc on          turn the PC on (no connection)
    pc work        turn on + remote desktop
    pc play        turn on + Moonlight

  End
    pc stop        end the Moonlight stream (monitors back on)
    pc release     end remote desktop (PC screen unlocked)

  Power
    pc off         shut down
    pc sleep       put to sleep

  Info
    pc status      is the PC on?
    pc doctor      check everything (VPN, UpSnap, SSH, Apollo …), says what is wrong
HELP
    fi ;;
esac
