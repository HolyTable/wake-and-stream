# Line endings: macOS/Linux scripts need LF, Windows scripts need CRLF – regardless of who checks out.
* text=auto eol=lf
*.sh       text eol=lf
*.py       text eol=lf
*.yml      text eol=lf
*.md       text eol=lf
.githooks/* text eol=lf
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# Binary files
*.png  binary
*.icns binary
